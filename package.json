{
  "name": "hinna-api-management-swagger",
  "version": "1.0.0",
  "description": "Centralized API documentation for Hinna microservices",
  "main": "index.js",
  "scripts": {
    "fetch-local": "node scripts/fetch-local-specs.js",
    "scan": "node scripts/scan-repository.js",
    "update": "node scripts/update-swagger.js",
    "list-repos": "node scripts/list-hinna-repos.js",
    "scan-all": "node scripts/scan-all-repositories.js",
    "validate": "swagger-cli validate public/swagger.yaml",
    "serve": "npx http-server public -p 8099 --cors",
    "test": "npm run validate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "ncu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BK-Hinna-Work/Hinna-API-Management-Swagger.git"
  },
  "keywords": [
    "swagger",
    "openapi",
    "api-documentation",
    "hinna"
  ],
  "author": "ABC Academy of Music",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BK-Hinna-Work/Hinna-API-Management-Swagger/issues"
  },
  "homepage": "https://github.com/BK-Hinna-Work/Hinna-API-Management-Swagger#readme",
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "axios": "^1.6.2",
    "js-yaml": "^4.1.0"
  }
}
